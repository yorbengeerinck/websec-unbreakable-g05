# Kopieer naar /etc/unbreakable/.env op de server (eigenaar: de runner-gebruiker,
# chmod 600). Zet hier NOOIT echte waarden in de repo; dit bestand bevat enkel
# placeholders.

# --- App ---------------------------------------------------------------
# Wachtwoord van de applicatie-database (postgres-gebruiker "unbreakable").
DB_PASSWORD=CHANGE_ME_app_db_password

# --- BunkerWeb ---------------------------------------------------------
APP_DOMAIN=g05.ipv6.thelastgym.be
BW_DB_PASSWORD=CHANGE_ME_bunkerweb_db_password
BW_UI_ADMIN_PASSWORD=CHANGE_ME_bunkerweb_ui_admin_password

# --- Keycloak (identity provider) --------------------------------------
AUTH_DOMAIN=auth.g05.ipv6.thelastgym.be
KC_DB_PASSWORD=CHANGE_ME_keycloak_db_password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_keycloak_bootstrap_admin_password

# --- OpenFGA (policy decision point) -----------------------------------
OPENFGA_DB_PASSWORD=CHANGE_ME_openfga_db_password
# Preshared key tussen app en OpenFGA. Genereer met: openssl rand -hex 32
OPENFGA_API_TOKEN=CHANGE_ME_openfga_preshared_key
# Ingevuld door deploy/openfga/bootstrap.sh (Y4); leeg laten tot dan.
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
